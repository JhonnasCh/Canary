# Configuración del Servidor Canary Sentinel
PORT=3000
HOST=0.0.0.0

# Proveedor de IA (local, openai, gemini, custom)
# 'local' funciona inmediatamente sin requerir API key con modelos heurísticos y semánticos.
AI_PROVIDER=local

# Cuando tengas tu API Key, configúrala aquí o desde la interfaz gráfica:
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-pro
AI_CUSTOM_ENDPOINT=

# Clave secreta del Guardián 24/7 para sincronizar webs de clientes
GUARDIAN_SECRET_KEY=canary-guard-sec-8f4b912c0e7a
